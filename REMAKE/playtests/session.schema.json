{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adr-remake/playtest-session-v3.schema.json",
  "title": "ADR remake unassisted decision-cohort session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "participantId",
    "cohortId",
    "recordedAt",
    "revision",
    "ruleset",
    "modePolicy",
    "modeTimeline",
    "experienceStatus",
    "operatorId",
    "consentAttested",
    "unassisted",
    "environment",
    "wallStartedAt",
    "wallEndedAt",
    "sittings",
    "closedPageGaps",
    "foregroundActiveMinutes",
    "backgroundOpenMinutes",
    "closedPageMinutes",
    "wallElapsedMinutes",
    "completed",
    "milestones",
    "deathEvents",
    "abandonmentPoint",
    "bottlenecks",
    "technicalExceptions",
    "exclusions"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "type": "string", "minLength": 1 },
    "participantId": { "type": "string", "minLength": 1 },
    "cohortId": { "type": "string", "minLength": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ruleset": { "type": "string", "minLength": 1 },
    "modePolicy": {
      "enum": ["classic-locked", "hyper-locked", "timeline-recorded"]
    },
    "modeTimeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "mode"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "mode": { "enum": ["classic", "hyper"] }
        }
      }
    },
    "experienceStatus": {
      "enum": ["first-time", "familiar", "experienced"]
    },
    "operatorId": { "type": "string", "minLength": 1 },
    "consentAttested": { "const": true },
    "unassisted": { "const": true },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "artifactId", "browser", "os"],
      "properties": {
        "artifactKind": { "const": "production-build" },
        "artifactId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "browser": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 }
      }
    },
    "wallStartedAt": { "type": "string", "format": "date-time" },
    "wallEndedAt": { "type": "string", "format": "date-time" },
    "sittings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startedAt",
          "endedAt",
          "foregroundActiveMinutes",
          "backgroundOpenMinutes"
        ],
        "properties": {
          "startedAt": { "type": "string", "format": "date-time" },
          "endedAt": { "type": "string", "format": "date-time" },
          "foregroundActiveMinutes": { "type": "number", "minimum": 0 },
          "backgroundOpenMinutes": { "type": "number", "minimum": 0 }
        }
      }
    },
    "closedPageGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startedAt", "endedAt"],
        "properties": {
          "startedAt": { "type": "string", "format": "date-time" },
          "endedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "foregroundActiveMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "backgroundOpenMinutes": { "type": "number", "minimum": 0 },
    "closedPageMinutes": { "type": "number", "minimum": 0 },
    "wallElapsedMinutes": { "type": "number", "exclusiveMinimum": 0 },
    "completed": { "type": "boolean" },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening",
        "compass",
        "firstExpedition",
        "deepEconomy",
        "executioner",
        "ship",
        "space",
        "completion"
      ],
      "properties": {
        "opening": { "$ref": "#/$defs/milestone" },
        "compass": { "$ref": "#/$defs/milestone" },
        "firstExpedition": { "$ref": "#/$defs/milestone" },
        "deepEconomy": { "$ref": "#/$defs/milestone" },
        "executioner": { "$ref": "#/$defs/milestone" },
        "ship": { "$ref": "#/$defs/milestone" },
        "space": { "$ref": "#/$defs/milestone" },
        "completion": { "$ref": "#/$defs/milestone" }
      }
    },
    "deathEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurredAt",
          "foregroundActiveMinute",
          "wallMinute",
          "phase",
          "cause"
        ],
        "properties": {
          "occurredAt": { "type": "string", "format": "date-time" },
          "foregroundActiveMinute": { "type": "number", "minimum": 0 },
          "wallMinute": { "type": "number", "minimum": 0 },
          "phase": {
            "enum": [
              "opening",
              "compass",
              "firstExpedition",
              "deepEconomy",
              "executioner",
              "ship",
              "space",
              "ending"
            ]
          },
          "cause": { "type": "string", "minLength": 1 }
        }
      }
    },
    "abandonmentPoint": { "type": ["string", "null"] },
    "bottlenecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "participantWords"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "participantWords": { "type": "string", "minLength": 1 }
        }
      }
    },
    "technicalExceptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 0,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "milestone": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reachedAt", "foregroundActiveMinute", "wallMinute"],
          "properties": {
            "reachedAt": { "type": "string", "format": "date-time" },
            "foregroundActiveMinute": { "type": "number", "minimum": 0 },
            "wallMinute": { "type": "number", "minimum": 0 }
          }
        }
      ]
    }
  }
}
