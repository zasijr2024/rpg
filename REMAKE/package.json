{
  "name": "adr-remake",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-production-bundle.mjs && node scripts/verify-performance-budgets.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,mts}\" \"*.{js,json,ts,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{mjs,mts}\" \"*.{js,json,ts,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "study:progression": "node -e \"console.log('Progression policy diagnostic: classified outcomes are not player completion evidence.')\" && vitest run --config vitest.progression.config.ts --reporter=verbose",
    "study:progression:corpus": "node scripts/progression-corpus.mjs --seeds=32 --start=0 --shard-size=4 --jobs=2",
    "study:human": "node scripts/summarize-playtests.mjs",
    "study:human:gate": "node scripts/summarize-playtests.mjs --require=3",
    "artifact:identity": "node scripts/production-artifact.mjs --dir=dist",
    "test:e2e": "playwright test",
    "test:e2e:parity": "playwright test --project chromium-1366 --project chromium-1920 --project chromium-2560 --project chromium-3840",
    "test:e2e:release": "playwright test --config playwright.release.config.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:production-spine": "playwright test --config playwright.production-spine.config.ts",
    "test:e2e:a11y": "playwright test --config playwright.release.config.ts accessibility-release.spec.ts",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "typecheck:fixtures": "tsc -p tsconfig.type-fixtures.json --pretty false",
    "check:architecture": "vitest run src/tests/architecture-boundaries.test.ts",
    "check:bundle-boundary": "node scripts/verify-production-bundle.mjs",
    "check:performance-budgets": "node scripts/verify-performance-budgets.mjs",
    "parity:generate": "node scripts/generate-parity-graph.mjs",
    "parity:check": "node scripts/generate-parity-graph.mjs --check",
    "gate:list": "node scripts/release-gates.mjs --list",
    "gate:parity": "node scripts/release-gates.mjs --gate parity-complete",
    "gate:beta": "node scripts/release-gates.mjs --gate production-beta",
    "gate:rc": "node scripts/release-gates.mjs --gate release-candidate",
    "closure:status": "node scripts/phase-closure.mjs",
    "closure:verify-tag": "node scripts/phase-closure.mjs --tag"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vite": "8.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.4",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
